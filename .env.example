# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Provided automatically by Replit when a PostgreSQL database is attached.
# Copy this file to .env for local development.
DATABASE_URL=postgresql://user:password@localhost:5432/matami
PGHOST=localhost
PGPORT=5432
PGDATABASE=matami
PGUSER=user
PGPASSWORD=password

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Secret used to sign admin JWT tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_secure_random_string_at_least_32_chars

# ── Admin ──────────────────────────────────────────────────────────────────────
# Password for the /admin panel (hashed server-side, never stored in plain text)
ADMIN_PASSWORD=your_secure_admin_password

# ── Cloudinary (optional — for cloud image hosting) ───────────────────────────
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Get credentials from https://cloudinary.com/console
CLOUDINARY_URL=cloudinary://123456789:abcdefghijklmnop@your-cloud-name

# ── Server ─────────────────────────────────────────────────────────────────────
# Assigned automatically by Replit workflows. Set manually for local dev.
PORT=3001
NODE_ENV=development
