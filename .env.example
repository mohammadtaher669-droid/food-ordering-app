# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Railway: injected automatically when you link a Postgres plugin.
#   Internal URL (postgres.railway.internal) is used when running on Railway —
#   SSL is not needed on the private network.
#   Public proxy URL (crossover.proxy.rlwy.net) is used for external tools
#   (psql, DB GUI) — the server auto-enables SSL for non-localhost URLs.
# Local dev: plain localhost connection, no SSL needed.
DATABASE_URL=postgresql://user:password@localhost:5432/matami

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Secret used to sign admin JWT tokens. Generate with: openssl rand -hex 32
# REQUIRED in production — without this a hardcoded insecure default is used.
JWT_SECRET=change_me_to_a_secure_random_string_at_least_32_chars

# ── Admin ──────────────────────────────────────────────────────────────────────
# Password for the /admin panel (compared server-side with timing-safe compare).
# Change before going live. Set in Railway → Variables panel.
ADMIN_PASSWORD=your_secure_admin_password

# ── Cloudinary (optional — for cloud image hosting) ───────────────────────────
# Without Cloudinary, images are stored as base64 inside PostgreSQL.
# This works but makes the DB large. Cloudinary keeps the DB lean.
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Alternative single-string format (takes precedence if set):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ── Server ─────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically. Set manually for local dev only.
PORT=3001
NODE_ENV=development
